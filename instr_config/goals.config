normal_request_verified = count_greater : 0 : ( _normal )
sql_injection_verified = boolean : ( _bypass and _server )
soc_log_collection_verified = count_greater : 0 : ( _collected )
soc_detection_verified = count_greater : 0 : ( _alert )
secure_remediation_verified = boolean : ( _safe_block and _safe_legit and _server_block and _server_legit )
